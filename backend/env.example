PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/mealtracking
# Used when Open Food Facts has no usable serving size: suggests a typical portion (grams) from product name, category, kcal/100g, pack size.
OPENAI_API_KEY=your_key_here

# Optional: Open Food Facts API asks for a descriptive User-Agent (https://openfoodfacts.github.io/openfoodfacts-server/api/)
OPENFOODFACTS_USER_AGENT=YourApp/1.0 (you@example.com)
# Optional; defaults to gpt-4o-mini (serving-size suggestion + any other OpenAI features you add)
OPENAI_MODEL=gpt-4o-mini
REVENUECAT_API_KEY_IOS=your_revenuecat_ios_key_here
